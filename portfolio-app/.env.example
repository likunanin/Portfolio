# Copy this file to .env and fill in your own values before running the server.

# Password you'll type in on the /admin login screen.
ADMIN_PASSWORD=changeme123

# Long random string used to sign the login session cookie.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-long-random-string

# Port the server listens on.
PORT=3000
